{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jls-navigator",
  "account_id": "4a0be15a938a847c43555a99ef72bea1",
  "compatibility_date": "2025-09-24",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/worker-entry.ts",
  // Expose the static assets as an env binding: a Worker can't HTTP-fetch its own
  // hostname, so server code reads files from public/ via env.ASSETS.fetch(...)
  // (e.g. the branded Quotation template backgrounds in public/qb-templates/).
  "assets": { "binding": "ASSETS" },
  "triggers": {
    "crons": ["*/15 * * * *", "0 * * * *", "5,20,35,50 * * * *", "*/5 * * * *"]
  },
  "vars": {
    "SUPABASE_URL": "https://cqzdroabjcdyncfqwawy.supabase.co",
    "SUPABASE_PUBLISHABLE_KEY": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImNxemRyb2FiamNkeW5jZnF3YXd5Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3Nzg4MjkyNjYsImV4cCI6MjA5NDQwNTI2Nn0.ZHjXFJuUCFa3aRHnUVvSK1pBxwtxZ5nWrdELlsT96-c",
    "VITE_APP_URL": "https://jls-navigator.m-peeters-4a0.workers.dev",

    // ── ALL outbound email — OFF since 2026-08-15 (MD instruction) ────────────
    // Client vessels received "<vessel> - TDRA" notices, so every kind of email is
    // switched off until each capability is deliberately turned back on.
    // Flip a value to "true" and push: the Cloudflare build picks it up on deploy.
    //
    //   EMAIL_ENABLED                → MASTER SWITCH. While "false" Polaris sends
    //                                  NOTHING, to anyone, internal or external.
    //                                  Turn this on first to restore staff email.
    //   CLIENT_EMAIL_ENABLED         → with the master on, allows delivery outside
    //                                  jlsyachts.com / newhorizon-it.co.uk
    //                                  (see src/lib/mail-guard.server.ts)
    //   PERMIT_EXPIRY_ALERTS_ENABLED → the daily 08:00 UTC permit expiry cron
    //
    // Restore order: EMAIL_ENABLED → CLIENT_EMAIL_ENABLED → PERMIT_EXPIRY_ALERTS,
    // verifying at each step.
    //
    // NOT covered by these switches (they are not Polaris sends): Supabase Auth
    // password-reset / invite mail, and Power Automate flows on the SharePoint
    // lists that email vessels when a list item changes.
    "EMAIL_ENABLED": "false",
    "CLIENT_EMAIL_ENABLED": "false",
    "PERMIT_EXPIRY_ALERTS_ENABLED": "false",

    // ── Outbound SharePoint push — permits suppressed since 2026-08-15 ────────
    // Writing a SharePoint list item triggers automation that lives on SharePoint,
    // beyond the reach of the mail guard: a Power Automate flow on the permits
    // list emailed vessels "<vessel> - TDRA" about a minute after ordinary permit
    // data entry pushed items across. Until that flow is turned off, Polaris does
    // not write to that list.
    //
    // Comma-separated targets, or "none" to restore every push. Inbound sync is
    // unaffected — SharePoint changes still flow INTO Polaris — and edits made in
    // Polaris stay queued (sharepoint_dirty_at), so the backlog syncs itself once
    // this is cleared.
    "SHAREPOINT_PUSH_DISABLED_TARGETS": "permits"
  }
}
